FROM burakince/mlflow:3.15.0
COPY --chown=10001:10001 mlflow /opt/venv/lib/python3.13/site-packages/mlflow
COPY --chown=10001:10001 mlflow/server/js/build /opt/venv/lib/python3.13/site-packages/mlflow/server/js/build
RUN /opt/venv/bin/python -c "import mlflow, mlflow.server, mlflow.server.handlers, mlflow.store.tracking.sqlalchemy_store, mlflow.store.artifact.s3_artifact_repo; print('MLflow version:', mlflow.__version__)"
